# Public browser-side settings. Supabase publishable/anon keys are not privileged secrets;
# database Row Level Security must enforce all access. Never place a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional Live Map basemap key. Restrict its allowed origins in the provider dashboard.
VITE_CARTO_API_KEY=replace-with-your-CARTO-basemaps-key
